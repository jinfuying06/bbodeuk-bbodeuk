# 이 파일을 복사해 .env로 저장하고 실제 키 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 깃허브에 올라가지 않습니다.
#   cp .env.example .env

# server/ax-recognize (AX 온보딩, 사진 기반 아이템 인식)에서 사용
ANTHROPIC_API_KEY=

# TypeSafe System One API (https://docs.typesafe.ai) 실험/연동용
TYPESAFE_API_KEY=

# jev-review MCP 플러그인(NiazMorshed2007/jev-review)용 — TYPESAFE_API_KEY와 동일한 값
JEV_API_KEY=
