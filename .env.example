# 이 파일을 복사해 .env로 저장하고 실제 키 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 깃허브에 올라가지 않습니다.
#   cp .env.example .env

# ── 빌드 시점(클라이언트) 값: VITE_ 접두사 → 번들에 그대로 들어가므로 공개돼도 되는 값만 ──
# 비워 두면 해당 기능 영역은 "준비중" 가림막으로 덮여 누를 수 없다(코드 수정 없이 값만 넣으면 열림).

# 토스페이먼츠 클라이언트 키(API 개별 연동 키, test_ck_… / live_ck_…). 결제창(추가 공간 원화 결제)에서 사용.
# 개발자센터 문서에 공개 테스트 키가 있어 가입 전에도 테스트 결제를 해볼 수 있다(시크릿 키와 짝을 맞춰 쓸 것).
VITE_TOSS_CLIENT_KEY=
# 결제 승인 서버 주소(server/payment-confirm). 로컬 dev: /api/payment/confirm
# 예) https://<vercel-프로젝트>.vercel.app/api/payment/confirm
VITE_PAYMENT_CONFIRM_URL=
# 사진 인식 서버 주소(server/ax-recognize). 로컬 dev: /api/ax/recognize
# 예) https://<vercel-프로젝트>.vercel.app/api/ax/recognize
VITE_AX_RECOGNIZE_URL=

# ── 서버 전용 값: 절대 VITE_ 접두사를 붙이지 말 것(Vercel 환경변수 / 로컬 .env) ──

# 토스페이먼츠 시크릿 키(test_sk_… / live_sk_…). server/payment-confirm 의 결제 승인에서만 사용.
TOSS_SECRET_KEY=
# server/ax-recognize (AX 온보딩, 사진 기반 아이템 인식)에서 사용
ANTHROPIC_API_KEY=

# TypeSafe System One API (https://docs.typesafe.ai) 실험/연동용
TYPESAFE_API_KEY=

# jev-review MCP 플러그인(NiazMorshed2007/jev-review)용 — TYPESAFE_API_KEY와 동일한 값
JEV_API_KEY=
